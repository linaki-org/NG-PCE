town_hall is scene:
    name: TOWN_HALL
    scale: 0.1, 1.8
    y_range: 230, 400
    transition: slide_left
    step_snd: "step_wood"

window is hotspot of town_hall:
    label: WINDOW_OLD
    coords: 60, 90
    width: 100
    height: 100
    walk_to: 110, 380
    verb: LOOKAT
    @lookat: say WINDOW_LOOK
    @open: say WINDOW_OPEN
    @use stone on window: say WINDOW_STONE

lantern is hotspot of town_hall:
    label: LANTERN_OLD
    coords: 600, 420
    scale: 0.1
    flag: farol_recogido
    verb: PICKUP
    @lookat: say LANTERN_LOOK
    @pickup: say LANTERN_PICK

strange_machine is hotspot of town_hall:
    label: MACHINE_STRANGE
    img: "animation_demo.png"
    coords: 280, 420
    scale: 0.65
    frames: 5
    speed: 200
    verb: USE
    solid: true
    @lookat: say MACHINE_LOOK
    @use:
        say MACHINE_USE
        anim strange_machine
    @push:
        say MACHINE_PUSH
        anim strange_machine

ambient_machine is ambient of town_hall:
    img: "animation_demo.png"
    x: 530
    y: 420
    frames: 5
    speed: 100
    scale: 0.4
    layer: BACK
    solid: true
    loop: true

ambient_fire is ambient of town_hall:
    x: 675
    y: 420
    label: BONFIRE
    frames: 50
    speed: 50
    scale: 1
    layer: BACK

th_ex1 is exit of town_hall:
    x: 0
    y: 0
    w: 50
    h: GAME_AREA_HEIGHT
    target: peace_avenue
    spawn: 750, 400

th_ex2 is exit of town_hall:
    x: 750
    y: 0
    w: 50
    h: GAME_AREA_HEIGHT
    target: dark_room
    spawn: 50, 400