peace_avenue is scene:
    name: AVDA_PAZ
    scale: 0.4, 2.2
    y_range: 230,400
    transition: fade
    @enter: say SCENE1_INTRO_MSG

bell is hotspot of peace_avenue:
    label: BELL
    coords: 480, 200
    walk_to: 480, 300
    hint: BELL_HINT
    scale: 0.1
    verb: LOOKAT
    @lookat: say BELL_LOOK
    @open: say BELL_OPEN
    @push: say BELL_PUSH
    @pull: say BELL_PULL
    @use:
        say BELL_MAGIC_USE
        sound "church-bell.ogg"
        flag puzzle_campana_resuelto
        delitem hammer

hammer is hotspot of peace_avenue:
    label: HAMMER
    coords: 450, 315
    scale: 0.08
    flag: martillo_recogido
    description: HAMMER_LOOK
    verb: LOOKAT
    solid: true
    @lookat: say HAMMER_LOOK
    @pickup: say HAMMER_PICK

pa_ex1 is exit of peace_avenue:
    x: 750
    y: 0
    w: 50
    h: GAME_AREA_HEIGHT
    target: town_hall
    spawn: 50, 400

pa_ex2 is exit of peace_avenue:
    x: 0
    y: 0
    w: 50
    h: GAME_AREA_HEIGHT
    target: panoramic
    spawn: 1500, 400